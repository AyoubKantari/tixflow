# Normalize line endings to LF in the repo and working tree.
# Code runs on Linux (containers, CI, Kubernetes); CRLF breaks shell scripts.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: no diff, no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.jar  binary
*.woff binary
*.woff2 binary
